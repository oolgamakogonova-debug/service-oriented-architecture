{
  "type": "record",
  "name": "InventoryCounted",
  "namespace": "warehouse.events.v1",
  "doc": "Пересчёт остатков (инвентаризация). Устанавливает available_quantity = counted_quantity",
  "fields": [
    {"name": "event_id",         "type": "string"},
    {"name": "event_type",       "type": "string", "default": "INVENTORY_COUNTED"},
    {"name": "timestamp",        "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "product_id",       "type": "string"},
    {"name": "zone_id",          "type": "string"},
    {"name": "counted_quantity", "type": "long"}
  ]
}
