{
  "type": "record",
  "name": "ProductReceived",
  "namespace": "warehouse.events.v1",
  "doc": "V2 — приёмка с supplier_id. Backward-compatible: supplier_id имеет default=null.",
  "fields": [
    {"name": "event_id",   "type": "string"},
    {"name": "event_type", "type": "string", "default": "PRODUCT_RECEIVED"},
    {"name": "timestamp",  "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "product_id", "type": "string"},
    {"name": "zone_id",    "type": "string"},
    {"name": "quantity",   "type": "long"},
    {"name": "supplier_id","type": ["null", "string"], "default": null}
  ]
}
