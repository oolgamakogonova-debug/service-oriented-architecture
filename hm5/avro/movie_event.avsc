{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "com.cinema.events",
  "doc": "Schema for movie event in online cinema analytics pipeline. Partition key: user_id — ensures ordering of all events for a given user within one partition, which is critical for session-based analysis (VIEW_STARTED always before VIEW_FINISHED).",
  "fields": [
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Unique event identifier (UUID v4)"
    },
    {
      "name": "user_id",
      "type": "string",
      "doc": "User identifier"
    },
    {
      "name": "movie_id",
      "type": "string",
      "doc": "Movie identifier"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "VIEW_STARTED",
          "VIEW_FINISHED",
          "VIEW_PAUSED",
          "VIEW_RESUMED",
          "LIKED",
          "SEARCHED"
        ]
      },
      "doc": "Type of the event"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Event time in UTC (milliseconds since epoch)"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]
      },
      "doc": "Device type"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Session identifier"
    },
    {
      "name": "progress_seconds",
      "type": "int",
      "default": 0,
      "doc": "Viewing progress in seconds (for view events)"
    }
  ]
}