# Kafka
KAFKA_BROKER_1=kafka1:9092
KAFKA_BROKER_2=kafka2:9093
KAFKA_TOPIC=movie-events
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1

# Schema Registry
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=cinema
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cinema_aggregates
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_secret

# MinIO (S3)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=movie-analytics

# Aggregation
AGGREGATION_INTERVAL_SECONDS=60

# Producer
PRODUCER_HOST=0.0.0.0
PRODUCER_PORT=8000
GENERATOR_ENABLED=true
GENERATOR_EVENTS_PER_SECOND=10
GENERATOR_NUM_USERS=100
GENERATOR_NUM_MOVIES=50s