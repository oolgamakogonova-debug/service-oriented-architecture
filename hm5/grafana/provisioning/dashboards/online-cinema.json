      "title": "Events per Hour (Last 24h)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "rawSql": "SELECT toStartOfHour(event_time) AS time, event_type, count() AS cnt FROM cinema.movie_events WHERE event_time >= now() - INTERVAL 24 HOUR GROUP BY time, event_type ORDER BY time ASC",
          "format": 1
        }
      ]
