      "type": "barchart",
      "targets": [
        {
          "rawSql": "SELECT movie_id, count() AS views FROM cinema.movie_events WHERE event_type = 'VIEW_STARTED' AND event_date >= today() - 7 GROUP BY movie_id ORDER BY views DESC LIMIT 10",
